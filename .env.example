# Own database only; never point this service at the clubs or users database.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sportmatch_payments
DB_USER=sportmatch_payments
DB_PASSWORD=replace-with-payments-password
JWT_SECRET=replace-with-shared-secret-at-least-32-bytes
JWT_ISSUER=sportmatch-auth
JWT_AUDIENCE=sportmatch-mobile
CLUBS_SERVICE_URL=http://127.0.0.1:8004
CLUBS_TIMEOUT_SECONDS=10
USERS_SERVICE_URL=http://127.0.0.1:8001
USERS_TIMEOUT_SECONDS=10
INTERNAL_SERVICE_TOKEN=replace-with-shared-internal-token-at-least-32-bytes
# Integración oficial de Transbank. Credenciales públicas, sin cobros reales.
# Para pruebas automatizadas sin red: WEBPAY_MOCK_MODE=true (solo INTEGRATION).
WEBPAY_MOCK_MODE=false
WEBPAY_ENVIRONMENT=INTEGRATION
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
WEBPAY_PUBLIC_URL=http://localhost:8000
WEBPAY_FRONTEND_RETURN_URL=http://localhost:8081/pago
WEBPAY_WEB_RETURN_URL=http://localhost:3001/pago/resultado
WEBPAY_TIMEOUT_SECONDS=15
# HU-55: aviso de vencimiento (3 días antes y el día del vencimiento). El gateway lo publica en /notifications.
# Desactívalo con false (p. ej. en pruebas o en réplicas de solo lectura). Intervalo en segundos (60–86400).
AVISO_VENCIMIENTO_ENABLED=true
AVISO_VENCIMIENTO_INTERVALO_SEGUNDOS=3600
AVISO_VENCIMIENTO_ZONA=America/Santiago
# Doble clic en «pagar»: se reutiliza el pago PENDING del mismo comprador/plan/cliente de menos de N minutos (0 = no reutilizar).
PAGO_REUTILIZAR_PENDIENTE_MINUTOS=10
# Conciliación: cada cuántos segundos revisa a Transbank los PENDING de más de N minutos (los cierra como APPROVED/REJECTED/CANCELLED).
PAGO_CONCILIAR_ENABLED=true
PAGO_CONCILIAR_MINUTOS=30
PAGO_CONCILIAR_INTERVALO_SEGUNDOS=900
